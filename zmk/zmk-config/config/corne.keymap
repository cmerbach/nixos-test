#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        Super {
            bindings = <&kp LGUI>;
            key-positions = <24 38>;
        };

        L_BT_CLR {
            bindings = <&bt BT_CLR>;
            key-positions = <0 36 37>;
        };

        R_BT_CLR {
            bindings = <&bt BT_CLR>;
            key-positions = <40 41 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC         &kp X     &kp V     &kp L             &kp C  &kp W        &kp K      &kp H  &kp G         &kp F    &kp Q  &kp BSPC
&kp TAB         &kp U     &kp I     &kp A             &kp E  &kp O        &kp S      &kp N  &kp R         &kp T    &kp D  &kp Z
&kp LEFT_SHIFT  &kp LBKT  &kp SEMI  &kp SQT           &kp P  &kp Y        &kp B      &kp M  &kp COMMA     &kp DOT  &kp J  &kp MINUS
                                    &kp LEFT_CONTROL  &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp LEFT_ALT
            >;
        };

        layer-1 {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &trans  &trans  &trans  &trans  &trans  &kp DELETE
&trans  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                    &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };

        layer-2 {
            bindings = <
&trans         &trans     &trans         &trans         &trans                 &trans          &kp NUMBER_6  &kp N7      &kp N8            &kp N9      &kp NUMBER_0  &kp DELETE
&kp LS(COMMA)  &kp RA(Q)  &kp RA(MINUS)  &kp BSLH       &kp NUBS               &kp LS(NUBS)    &kp RA(N8)    &kp RA(N9)  &kp RA(NUMBER_7)  &kp RA(N0)  &kp UP        &kp RBKT
&trans         &trans     &kp GRAVE      &kp LS(EQUAL)  &kp RA(RIGHT_BRACKET)  &kp COMMA       &trans        &trans      &trans            &kp LEFT    &kp DOWN      &kp RIGHT
                                         &trans         &trans                 &trans          &trans        &trans      &trans
            >;
        };
    };
};
