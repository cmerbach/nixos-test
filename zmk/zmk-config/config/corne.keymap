#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        Super {
            bindings = <&kp LGUI>;
            key-positions = <24 38>;
        };

        L_BT_CLR {
            bindings = <&bt BT_CLR>;
            key-positions = <0 36 37>;
        };

        R_BT_CLR {
            bindings = <&bt BT_CLR>;
            key-positions = <40 41 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC         &kp Y  &kp Z  &kp U             &kp A    &kp Q        &kp P      &kp B  &kp M         &kp L    &kp F  &kp BSPC
&kp TAB         &kp C  &kp S  &kp I             &kp E    &kp O        &kp D      &kp T  &kp N         &kp R    &kp H  &kp J
&kp LEFT_SHIFT  &kp V  &kp X  &kp LBKT          &kp SQT  &kp SEMI     &kp W      &kp G  &kp COMMA     &kp DOT  &kp K  &kp MINUS
                              &kp LEFT_CONTROL  &mo 1    &kp SPACE    &kp ENTER  &mo 2  &kp LEFT_ALT
            >;
        };

        layer-1 {
            bindings = <
&trans  &kp NUMBER_1   &kp NUMBER_2           &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &trans     &trans         &trans  &trans  &trans  &kp DELETE
&trans  &kp RA(MINUS)  &kp LS(NUMBER_7)       &kp RA(N7)    &kp RA(N0)    &trans          &trans     &trans         &trans  &trans  &trans  &trans
&trans  &kp BSLH       &kp RA(RIGHT_BRACKET)  &kp RA(N8)    &kp RA(N9)    &kp RBKT        &kp GRAVE  &kp LS(EQUAL)  &trans  &trans  &trans  &trans
                                              &trans        &trans        &trans          &trans     &trans         &trans
            >;
        };

        layer-2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp NUMBER_6      &kp N7            &kp N8            &kp N9     &kp NUMBER_0  &kp DELETE
&trans  &trans  &trans  &trans  &trans  &trans    &kp LS(NUMBER_0)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp SLASH  &kp UP        &kp RA(Q)
&trans  &trans  &trans  &trans  &trans  &trans    &kp RA(NUBS)      &kp NUBS          &kp LS(NUBS)      &kp LEFT   &kp DOWN      &kp RIGHT
                        &trans  &trans  &trans    &trans            &trans            &trans
            >;
        };
    };
};
